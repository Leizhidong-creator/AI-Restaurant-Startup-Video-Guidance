YONGGE_ENVIRONMENT=development
YONGGE_DATABASE_URL=sqlite+aiosqlite:///./data/yongge_online.db
YONGGE_UPLOAD_DIR=./uploads
YONGGE_MAX_UPLOAD_MB=50

# One Beijing Model Studio workspace key can call all configured Qwen models.
YONGGE_DASHSCOPE_API_KEY=
YONGGE_DASHSCOPE_HOST=your-workspace-id.cn-beijing.maas.aliyuncs.com
YONGGE_QWEN_VIDEO_MODEL=qwen3.5-omni-plus
YONGGE_QWEN_AGENT_MODEL=qwen3.7-plus
YONGGE_QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
YONGGE_QWEN_ASR_MODEL=qwen3-asr-flash-realtime

# Optional integrations. Missing values activate explicit fallback adapters.
YONGGE_AMAP_WEB_SERVICE_KEY=
YONGGE_PUBLIC_BASE_URL=
YONGGE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# 抖音链接取视频(yt-dlp)可选兜底:平台风控时从本地浏览器读 cookies,如 "chrome"
YT_DLP_COOKIES_FROM_BROWSER=
